{
  "compilerOptions": { "target": "ES2022", "module": "preserve", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "skipLibCheck": true, "experimentalDecorators": true,
    "isolatedModules": true, "esModuleInterop": true, "useDefineForClassFields": false,
    "noImplicitOverride": true, "noFallthroughCasesInSwitch": true },
  "angularCompilerOptions": { "strictTemplates": true, "strictInjectionParameters": true, "strictInputAccessModifiers": true }
}
